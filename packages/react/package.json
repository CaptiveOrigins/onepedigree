{
  "name": "@captiveorigins/onepedigree-react",
  "version": "0.1.0-alpha.12",
  "description": "OnePedigree for React: server-renderable SVG pedigree views (all 13), an interactive explorer, headless hooks and CSS-variable styling.",
  "homepage": "https://github.com/mgilardi/onepedigree#readme",
  "bugs": {
    "url": "https://github.com/mgilardi/onepedigree/issues"
  },
  "keywords": [
    "pedigree",
    "genealogy",
    "family-tree",
    "react",
    "svg",
    "breeding"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mgilardi/onepedigree.git",
    "directory": "packages/react"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-LICENSE-LUCIDE.txt"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/styles.css dist/styles.css",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@captiveorigins/onepedigree-core": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
