{
  "name": "@captiveorigins/onepedigree-core",
  "version": "0.1.0-alpha.8",
  "description": "OnePedigree core: species-neutral pedigree data model, validation, bounded traversal, view projections and layout. No React, Payload or database dependency.",
  "keywords": [
    "pedigree",
    "genealogy",
    "family-tree",
    "breeding",
    "ancestry",
    "graph"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mgilardi/onepedigree.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup src/index.ts src/schema.ts --format esm --dts --clean --target node22",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build"
  }
}
