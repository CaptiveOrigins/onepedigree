{
  "name": "@captiveorigins/payload-plugin-onepedigree",
  "version": "0.1.0-alpha.13",
  "description": "OnePedigree for Payload: parentage fields, cycle-safe parentage writes, deletion policies, permission-aware pedigree endpoints for all 13 views, and Admin previews.",
  "homepage": "https://github.com/CaptiveOrigins/onepedigree#readme",
  "bugs": {
    "url": "https://github.com/CaptiveOrigins/onepedigree/issues"
  },
  "keywords": [
    "payload",
    "payload-plugin",
    "payloadcms",
    "pedigree",
    "genealogy",
    "breeding"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CaptiveOrigins/onepedigree.git",
    "directory": "packages/payload"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@captiveorigins/onepedigree-core": "workspace:^",
    "@captiveorigins/onepedigree-react": "workspace:^"
  },
  "peerDependencies": {
    "@payloadcms/ui": "^3.80.0",
    "payload": "^3.80.0",
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "@payloadcms/ui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@payloadcms/db-mongodb": "3.92.1",
    "@payloadcms/ui": "^3.92.1",
    "@types/react": "^19.3.0",
    "graphql": "^16.14.2",
    "mongodb-memory-server": "^11.3.0",
    "payload": "^3.92.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
