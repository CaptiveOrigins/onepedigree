{
  "name": "@extantape/onepedigree-studbook",
  "version": "0.1.0-alpha.22",
  "type": "module",
  "description": "OnePedigree studbook: species-neutral studbook numbering, pedigree-based kinship, inbreeding, mean kinship, gene diversity and founder analysis, and PMx export, for any managed population.",
  "keywords": [
    "studbook",
    "pedigree",
    "kinship",
    "mean-kinship",
    "gene-diversity",
    "conservation-breeding",
    "pmx"
  ],
  "homepage": "https://github.com/ExtantApe/OnePedigree#readme",
  "bugs": {
    "url": "https://github.com/ExtantApe/OnePedigree/issues"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./payload": {
      "types": "./dist/payload.d.ts",
      "import": "./dist/payload.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/payload.ts --format esm --dts --clean --target node22 --tsconfig tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@extantape/onepedigree-core": "workspace:^"
  },
  "peerDependencies": {
    "payload": "^3.80.0"
  },
  "peerDependenciesMeta": {
    "payload": {
      "optional": true
    }
  },
  "devDependencies": {
    "@payloadcms/db-mongodb": "3.92.1",
    "mongodb-memory-server": "^11.3.0",
    "payload": "^3.92.1"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExtantApe/OnePedigree.git",
    "directory": "packages/studbook"
  }
}
