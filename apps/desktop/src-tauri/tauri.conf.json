{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OnePedigree",
  "version": "0.1.0",
  "identifier": "org.captiveorigins.onepedigree",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OnePedigree",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Education",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": [
          "ged"
        ],
        "name": "GEDCOM family tree",
        "role": "Viewer"
      },
      {
        "ext": [
          "json"
        ],
        "name": "OnePedigree file",
        "role": "Editor"
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/mgilardi/onepedigree/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5QTIyRjA2QTI5QjJCREUKUldUZUs1dWlCaStpbWNXS3pBWVJDQ3NBa0FVMFNVcjROT2VXSHYyUU83WU5RekFldzdUcXB1RE8K"
    }
  }
}
